<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>TGS.Services.Operator</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Protos\brandcert.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Tools" Version="2.50.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.3.44">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PagingUtility.AsyncEnumerable" Version="1.1.0" />
    <PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
    <PackageReference Include="Polly" Version="7.2.3" />
    <PackageReference Include="Scrutor" Version="4.2.0" />
    <PackageReference Include="System.Linq.Async" Version="6.0.1" />
    <PackageReference Include="Tgs.BrandCertificateClient" Version="0.0.20" />
    <PackageReference Include="Tgs.CashService.Client" Version="0.1.5" />
    <PackageReference Include="TGS.Core.Infrastructures.Mail" Version="0.0.6" />
    <PackageReference Include="Tgs.Core.Infrastructures.Security" Version="0.0.1" />
    <PackageReference Include="Tgs.DepositAccumulateRoulette.Client" Version="0.0.4" />
    <PackageReference Include="TGS.FileService.Client" Version="0.0.5" />
    <PackageReference Include="Tgs.GameProviders.Pluggable.Client" Version="0.0.26" />
    <PackageReference Include="Tgs.Payment.Client" Version="0.4.7" />
    <PackageReference Include="Tgs.PaymentService.Client" Version="0.6.17" />
    <PackageReference Include="Tgs.PlayerService.Client" Version="0.0.19" />
    <PackageReference Include="Tgs.Promotion.Client" Version="1.0.28" />  
    <PackageReference Include="Tgs.RouletteSignInClient" Version="0.0.3" />
    <PackageReference Include="TGS.ServiceUtility" Version="0.1.0" />
    <PackageReference Include="TGS.SmsServiceClient" Version="0.0.7" />
    <PackageReference Include="Tgs.ValidateCode.Client" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bucket\PlayerBucket.Core.csproj" />
    <ProjectReference Include="..\Operations\Operations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\brandcert.proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
