<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <RootNamespace>TGS.Services.Operator</RootNamespace>
    <Nullable>enable</Nullable>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SqlQueryToolsConnectionString />
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Protos\brandcert.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Tools" Version="2.58.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.7.30">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PhoenixToolkits.MessageQueue" Version="1.0.3" />
    <PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
    <PackageReference Include="Polly" Version="7.2.4" />
    <PackageReference Include="Scrutor" Version="4.2.2" />
    <PackageReference Include="System.Linq.Async" Version="6.0.1" />
    <PackageReference Include="System.Reactive" Version="6.0.0" />
    <PackageReference Include="Tgs.BrandCertificateClient" Version="0.0.28" />
    <PackageReference Include="Tgs.CashService.Client" Version="0.1.9" />
    <PackageReference Include="TGS.Core.Infrastructures.Mail" Version="0.0.6" />
    <PackageReference Include="Tgs.Core.Infrastructures.Security" Version="0.0.2" />
    <PackageReference Include="Tgs.DepositAccumulateRoulette.Client" Version="0.0.6" />
    <PackageReference Include="TGS.FileService.Client" Version="0.0.5" />
    <PackageReference Include="Tgs.GameProviders.Pluggable.Client" Version="0.0.33" />
    <PackageReference Include="Tgs.Notification.Client" Version="0.0.2" />
    <PackageReference Include="Tgs.Paging.AsyncEnumerable" Version="1.2.1" />
    <PackageReference Include="Tgs.Payment.Client" Version="0.5.0" />
    <PackageReference Include="Tgs.PaymentService.Client" Version="0.7.3" />
    <PackageReference Include="Tgs.PlayerBucket.Client" Version="0.1.1" />
    <PackageReference Include="Tgs.PlayerBucketType.Client" Version="0.0.9" />
    <PackageReference Include="Tgs.PlayerService.Client" Version="0.0.37" />
    <PackageReference Include="Tgs.Promotion.Client" Version="1.0.44" />  
    <PackageReference Include="Tgs.RouletteSignInClient" Version="0.0.3" />
    <PackageReference Include="TGS.ServiceUtility" Version="0.2.0" />
    <PackageReference Include="TGS.SmsServiceClient" Version="0.0.8" />
    <PackageReference Include="Tgs.StationLetter.Client" Version="0.0.7" />
    <PackageReference Include="Tgs.ValidateCode.Client" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Operations\Operations.csproj" />
    <ProjectReference Include="..\Operator.Client\Operator.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\brandcert.proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
