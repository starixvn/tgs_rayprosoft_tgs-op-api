{
	"$schema": "http://json.schemastore.org/launchsettings.json",
	"profiles": {
		"OperatorApi": {
			"commandName": "Project",
			"launchBrowser": false,
			"launchUrl": "swagger",
			"environmentVariables": {
				"ASPNETCORE_ENVIRONMENT": "Development",
				"OTEL_SERVICE_NAME": "Operator-Api(local)",
				"NODE_IP": "otel.rpgp.cc"
			},
			"applicationUrl": "https://localhost:7001;http://localhost:7000"
		},
		"Docker": {
			"commandName": "Docker",
			"launchBrowser": true,
			"launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/health",
			"publishAllPorts": true,
			"useSSL": true,
			"environmentVariables": {
				"ASPNETCORE_ENVIRONMENT": "Development",
				"OTEL_SERVICE_NAME": "Operator-API(local)",
				"NODE_IP": "otel.rpgp.cc"
			}
		},
		"WSL 2": {
			"commandName": "WSL2",
			"launchBrowser": true,
			"launchUrl": "https://localhost:7003/swagger",
			"environmentVariables": {
				"ASPNETCORE_URLS": "https://localhost:7001;http://localhost:7000",
				"ASPNETCORE_ENVIRONMENT": "Development",
				"OTEL_SERVICE_NAME": "Operator-API(local)",
				"NODE_IP": "otel.rpgp.cc"
			},
			"distributionName": ""
		}
	}
}