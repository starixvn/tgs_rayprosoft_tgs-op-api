<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net7.0</TargetFramework>
		<UserSecretsId>e0868ee3-eaa7-4a0e-885a-9ccf907086e0</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<AssemblyName>TGS.Apis.OperatorApi</AssemblyName>
		<RootNamespace>TGS.Apis.OperatorApi</RootNamespace>
		<DockerfileBuildArguments>--build-arg "BuildConfiguration=$(Configuration)"</DockerfileBuildArguments>
		<DockerfileTag Condition="$(DockerfileTag) == ''">operator-api</DockerfileTag>
	</PropertyGroup>

	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<Nullable>disable</Nullable>
		<IsPublishable>True</IsPublishable>
		<ImplicitUsings>enable</ImplicitUsings>
		<NeutralLanguage>en-US</NeutralLanguage>
		<Version></Version>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<Optimize>false</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Handlers\**" />
		<Compile Remove="Services\**" />
		<Content Remove="Handlers\**" />
		<Content Remove="Services\**" />
		<EmbeddedResource Remove="Handlers\**" />
		<EmbeddedResource Remove="Services\**" />
		<None Remove="Handlers\**" />
		<None Remove="Services\**" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="appsettings.Debug.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FluentdForward.OpenTelemetry.MessagePack" Version="0.3.0" />
		<PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="7.0.5" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.18.1" />
		<PackageReference Include="Microsoft.VisualStudio.SlowCheetah" Version="4.0.30">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.6.40">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="OpenTelemetry" Version="1.4.0" />
		<PackageReference Include="OpenTelemetry.Contrib.Instrumentation.EntityFrameworkCore" Version="1.0.0-beta2" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.4.0" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.4.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.0.0-rc9" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.0.0-rc9" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.0.0" />
		<PackageReference Include="ProfileViewer.OpenTelemetry.Exporter" Version="0.2.1" />
		<PackageReference Include="Scrutor" Version="4.2.2" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
		<PackageReference Include="Tgs.Interceptors" Version="0.2.1" />
		<PackageReference Include="Tgs.MessageQueue.Nats" Version="2.3.0" />
		<PackageReference Include="Tgs.Notification.Client" Version="0.0.2" />
		<PackageReference Include="Tgs.Payment.AlfaPay.Client" Version="0.0.7" />
		<PackageReference Include="Tgs.Payment.FiveSevenPay.Client" Version="0.0.3" />
		<PackageReference Include="Tgs.Payment.GCPay.Client" Version="0.0.2" />
		<PackageReference Include="Tgs.Payment.Help2Pay.Client" Version="0.0.6" />
		<PackageReference Include="Tgs.Payment.LeePay.Client" Version="0.0.11" />
		<PackageReference Include="Tgs.Payment.MalakiPay.Client" Version="0.0.5" />
		<PackageReference Include="Tgs.Payment.ManualDeposit" Version="0.1.13" />
		<PackageReference Include="Tgs.Payment.MaticPay.Client" Version="0.0.6" />
		<PackageReference Include="Tgs.Payment.MetaPay.Client" Version="0.0.8" />
		<PackageReference Include="Tgs.Payment.PhpGoPay.Client" Version="0.0.4" />
		<PackageReference Include="Tgs.Payment.PrimePay.Client" Version="0.0.6" />
		<PackageReference Include="Tgs.Payment.SkyPay.Client" Version="0.0.6" />
		<PackageReference Include="Tgs.Payment.TuPay.Client" Version="0.0.5" />
		<PackageReference Include="Tgs.Payment.UmPay.Client" Version="0.0.1" />
		<PackageReference Include="Tgs.Payment.WandaPay.Client" Version="0.0.5" />
		<PackageReference Include="Tgs.Payment.ZeroNineNinePay.Client" Version="0.0.7" />
		<PackageReference Include="Tgs.Report.Client" Version="0.0.57" />
		<PackageReference Include="Tgs.WebApi.Toolkits" Version="0.2.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\IdentityVerifiers\IdentityVerifiers.csproj" />
		<ProjectReference Include="..\Operator.Core\Operator.Core.csproj" />
		<ProjectReference Include="..\Operator.Repositories\Operator.Repositories.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="appsettings.Development.json">
			<TransformOnBuild>true</TransformOnBuild>
		</Content>
		<Content Update="appsettings.json">
			<TransformOnBuild>true</TransformOnBuild>
		</Content>
	</ItemGroup>
</Project>
